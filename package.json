{
  "name": "smart-kitchen",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first cooking and baking application with an English and Arabic interface.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:mobile": "npm run start -w @smart-kitchen/mobile",
    "dev:api": "npm run start:dev -w @smart-kitchen/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate -w @smart-kitchen/api"
  }
}

EXPO_PUBLIC_API_URL=http://localhost:3000

# Public Supabase values only. Provider client secrets stay in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set a provider to true only after it is enabled in Supabase. Otherwise its button stays hidden.
EXPO_PUBLIC_AUTH_GOOGLE=false
EXPO_PUBLIC_AUTH_APPLE=false

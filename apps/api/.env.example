DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_kitchen?schema=public
PORT=3000
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Backend only. Public development key; paid key required before app-store release.
THEMEALDB_API_KEY=1

# Supabase Auth project URL. The API verifies access tokens with this project's
# public JWKS. Do not put the service-role key, JWT secret, or provider secrets here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
